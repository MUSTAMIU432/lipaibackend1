# =============================================================================
# Lipaidox backend — environment template (SECURITY)
# -----------------------------------------------------------------------------
# 1. Copy this file to `.env` in the SAME directory as `manage.py`:
#      cp .env.example .env
# 2. Fill in values locally / in CI secrets / in your host secret manager.
# 3. NEVER commit `.env`, service account JSON, or private keys to git.
# 4. Add to `.gitignore`: `.env`, `*.pem`, `firebase-creds.json`, `*-sa.json`
# 5. If any secret was ever pushed to a remote, rotate it in Google Cloud Console.
# =============================================================================

# --- Django core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Frontend (password-reset links, etc.) ---
FRONTEND_ORIGIN=http://localhost:3000
# Django magic link: SPA route with ?token=... → resetPasswordWithToken
PASSWORD_RESET_FRONTEND_PATH=/reset-password

# OTP email: include a “continue in app” URL (FRONTEND_ORIGIN + path) so the SPA can pre-fill digits.
PASSWORD_RESET_OTP_LINK_ENABLED=True
PASSWORD_RESET_OTP_PREFILL_PATH=/forgot-password

# True = skip sending OTP email; GraphQL returns ``inlineOtp`` so the Next app can auto-fill.
# Never enable on a public production API (any caller who passes tenant + email sees the code).
PASSWORD_RESET_INLINE_OTP=False

# -----------------------------------------------------------------------------
# Forgot password — OTP in email (GraphQL `requestPasswordReset`)
# -----------------------------------------------------------------------------
# Flow: user enters email on Next `/forgot-password` → GraphQL `requestPasswordReset`
# → backend generates a **6-digit code**, stores a hash, sends plain code via **SMTP**
# (`lipaidox.auth.email_outbound.send_password_reset_otp_email` → Django `send_mail`).
#
# Checklist for **real inbox** delivery:
#   1) Keep PASSWORD_RESET_INLINE_OTP=False (above) so the OTP is only emailed, not in GraphQL.
#   2) Fill EMAIL_HOST + EMAIL_HOST_* + DEFAULT_FROM_EMAIL (SMTP block below).
#   3) FRONTEND_ORIGIN must match your Next app URL (optional “continue” link in OTP email).
#   4) Restart Django after changing `.env`.

# -----------------------------------------------------------------------------
# Email (SMTP) — Django `send_mail` (password-reset OTP + magic-link reset)
# -----------------------------------------------------------------------------
# Leave EMAIL_HOST empty → **console** backend: OTP body prints in **runserver** terminal
# (good for local API tests without a provider).
#
# Provider examples (set one host; match TLS/SSL to their docs):
#   SendGrid:   EMAIL_HOST=smtp.sendgrid.net   EMAIL_PORT=587   EMAIL_USE_TLS=True
#   Mailgun:    EMAIL_HOST=smtp.mailgun.org    EMAIL_PORT=587   EMAIL_USE_TLS=True
#   Gmail:      EMAIL_HOST=smtp.gmail.com      use an **App Password** (not your login password)
#
# Common failures: (1) EMAIL_USE_TLS=True and EMAIL_USE_SSL=True together — Django rejects.
# (2) Port 465 requires SSL on, TLS off. (3) EMAIL_HOST must be a hostname, not your @gmail.com.
# (4) EMAIL_BACKEND=...console... in .env sends nothing by SMTP even if EMAIL_HOST is set.
#   Amazon SES: use SES SMTP endpoint + SMTP credentials from IAM
#
# DEFAULT_FROM_EMAIL must be a sender your provider allows (verified domain/single sender).

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=

# Port 465 “implicit SSL”: set EMAIL_USE_SSL=True and usually EMAIL_USE_TLS=False
# EMAIL_PORT=465
# EMAIL_USE_TLS=False
# EMAIL_USE_SSL=True

# Optional: force Django mail backend (default: SMTP if EMAIL_HOST set, else console).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# -----------------------------------------------------------------------------
# Google OAuth Web client (GIS fallback) — NOT required if you only use Firebase Auth
# -----------------------------------------------------------------------------
# OAuth 2.0 Client ID type "Web application". Only needed when the frontend uses Google
# Identity Services (GIS) instead of Firebase; GraphQL exposes it as googleOauthClientId.
# In Google Cloud → Credentials → that Web client → add Authorized JavaScript origins
# (e.g. http://localhost:3000 and http://127.0.0.1:3000) or the GIS iframe returns 403.
GOOGLE_OAUTH_CLIENT_ID=

# Optional: extra Web client IDs, comma-separated, if tokens may use another `aud`.
# GOOGLE_OAUTH_ADDITIONAL_CLIENT_IDS=

# Redirect URI string must match Google Cloud Console exactly (redirect-based OAuth).
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/your-google-callback-path

# Space-separated scopes for authorize URL (default is fine for email/profile).
GOOGLE_OAUTH_SCOPES=openid email profile

# -----------------------------------------------------------------------------
# Firebase — Admin SDK verifies Firebase ID tokens on `googleAuth` (service account JSON / .env).
# Forgot password for Firebase **email/password** users: use the Firebase **Web SDK**
# `sendPasswordResetEmail` in the frontend (Firebase sends mail; configure templates + authorized
# domains in Firebase Console). No FIREBASE_WEB_API_KEY on Django for that flow.
#
# Optional: FIREBASE_PROJECT_ID in .env; if empty, ``project_id`` is read from the service account JSON.
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=

# Absolute path to the service account JSON (the whole file — preferred for local dev).
# Create in GCP: IAM → Service Accounts → Keys → Add key → JSON. Store outside git.
# Example: /home/you/secrets/lipaidox-platform-firebase-adminsdk.json
FIREBASE_SERVICE_ACCOUNT_PATH=

# Alternative: put the SAME json file contents without committing the file:
#   base64 -w0 your-key.json   → paste one line into FIREBASE_SERVICE_ACCOUNT_B64
# Or FIREBASE_SERVICE_ACCOUNT_JSON= entire JSON on one line (harder due to quotes/newlines in private_key).
# FIREBASE_SERVICE_ACCOUNT_B64=
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Or place a copy as tempo_back/lipaidox/auth/googleOuth/firebase-service-account.local.json (gitignored).

# On Cloud Run / GCE with workload identity you may use ADC instead of a JSON key file:
# FIREBASE_ALLOW_APPLICATION_DEFAULT_CREDENTIALS=True

# -----------------------------------------------------------------------------
# Groq — vision LLM for the `/discover` page (lost_found.services.vision_service).
# Powers the Search, AI Verify, Price (image->product-name), and Community
# expert-verdict tabs via Llama 4 Scout (multimodal). Free tier: get a key in
# under a minute at https://console.groq.com/keys (no billing required;
# 1,000 requests/day, 30/minute — far more generous than Gemini's 20/day).
# Read directly via python-decouple in vision_service.py — does NOT go
# through settings.py.
# -----------------------------------------------------------------------------
GROK_API_KEY=
# Optional override of the model id (defaults to meta-llama/llama-4-scout-17b-16e-instruct if unset).
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
