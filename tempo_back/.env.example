# =============================================================================
# Lipaidox backend — environment template (SECURITY)
# -----------------------------------------------------------------------------
# 1. Copy this file to `.env` in the SAME directory as `manage.py`:
#      cp .env.example .env
# 2. Fill in values locally / in CI secrets / in your host secret manager.
# 3. NEVER commit `.env`, service account JSON, or private keys to git.
# 4. Add to `.gitignore`: `.env`, `*.pem`, `firebase-creds.json`, `*-sa.json`
# 5. If any secret was ever pushed to a remote, rotate it in Google Cloud Console.
# =============================================================================

# --- Django core ---
SECRET_KEY=change-me-to-a-long-random-string
# Production (Render): DEBUG=False. Never True on a public host.
DEBUG=True
# Local: 127.0.0.1/localhost for the host machine, 10.0.2.2 for the Android emulator,
# your LAN IP (e.g. 192.168.1.195) for a physical phone. Render's *.onrender.com host
# is added automatically from RENDER_EXTERNAL_HOSTNAME.
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2
# Browser origins only (the Next web app). The native mobile app sends no Origin
# header and needs no CORS entry. Outside DEBUG nothing is allowed unless listed.
# CORS_ALLOWED_ORIGINS=https://your-web-frontend.example.com
# Defaults to CORS_ALLOWED_ORIGINS; only needed for cookie/session POSTs (Django admin).
# CSRF_TRUSTED_ORIGINS=https://your-web-frontend.example.com

# --- Frontend (password-reset links, etc.) ---
FRONTEND_ORIGIN=http://localhost:3000
# Django magic link: SPA route with ?token=... → resetPasswordWithToken
PASSWORD_RESET_FRONTEND_PATH=/reset-password

# OTP email: include a “continue in app” URL (FRONTEND_ORIGIN + path) so the SPA can pre-fill digits.
PASSWORD_RESET_OTP_LINK_ENABLED=True
PASSWORD_RESET_OTP_PREFILL_PATH=/forgot-password

# True = skip sending OTP email; GraphQL returns ``inlineOtp`` so the Next app can auto-fill.
# Never enable on a public production API (any caller who passes tenant + email sees the code).
PASSWORD_RESET_INLINE_OTP=False

# -----------------------------------------------------------------------------
# Forgot password — OTP in email (GraphQL `requestPasswordReset`)
# -----------------------------------------------------------------------------
# Flow: user enters email on Next `/forgot-password` → GraphQL `requestPasswordReset`
# → backend generates a **6-digit code**, stores a hash, sends plain code via **SMTP**
# (`lipaidox.auth.email_outbound.send_password_reset_otp_email` → Django `send_mail`).
#
# Checklist for **real inbox** delivery:
#   1) Keep PASSWORD_RESET_INLINE_OTP=False (above) so the OTP is only emailed, not in GraphQL.
#   2) Fill EMAIL_HOST + EMAIL_HOST_* + DEFAULT_FROM_EMAIL (SMTP block below).
#   3) FRONTEND_ORIGIN must match your Next app URL (optional “continue” link in OTP email).
#   4) Restart Django after changing `.env`.

# -----------------------------------------------------------------------------
# Email (SMTP) — Django `send_mail` (password-reset OTP + magic-link reset)
# -----------------------------------------------------------------------------
# Leave EMAIL_HOST empty → **console** backend: OTP body prints in **runserver** terminal
# (good for local API tests without a provider).
#
# Provider examples (set one host; match TLS/SSL to their docs):
#   SendGrid:   EMAIL_HOST=smtp.sendgrid.net   EMAIL_PORT=587   EMAIL_USE_TLS=True
#   Mailgun:    EMAIL_HOST=smtp.mailgun.org    EMAIL_PORT=587   EMAIL_USE_TLS=True
#   Gmail:      EMAIL_HOST=smtp.gmail.com      use an **App Password** (not your login password)
#
# Common failures: (1) EMAIL_USE_TLS=True and EMAIL_USE_SSL=True together — Django rejects.
# (2) Port 465 requires SSL on, TLS off. (3) EMAIL_HOST must be a hostname, not your @gmail.com.
# (4) EMAIL_BACKEND=...console... in .env sends nothing by SMTP even if EMAIL_HOST is set.
#   Amazon SES: use SES SMTP endpoint + SMTP credentials from IAM
#
# DEFAULT_FROM_EMAIL must be a sender your provider allows (verified domain/single sender).

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=

# Port 465 “implicit SSL”: set EMAIL_USE_SSL=True and usually EMAIL_USE_TLS=False
# EMAIL_PORT=465
# EMAIL_USE_TLS=False
# EMAIL_USE_SSL=True

# Optional: force Django mail backend (default: SMTP if EMAIL_HOST set, else console).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# -----------------------------------------------------------------------------
# Google OAuth Web client (legacy raw-Google-token sign-in) — NOT needed for Firebase
# -----------------------------------------------------------------------------
# Only verifies raw Google ID tokens: mobile builds before 1.2.0 and GIS web clients.
# Leave empty to use the code default (the old mobile Web client). Firebase sign-ins
# do not use this at all.
# In Google Cloud → Credentials → that Web client → add Authorized JavaScript origins
# (e.g. http://localhost:3000 and http://127.0.0.1:3000) or the GIS iframe returns 403.
GOOGLE_OAUTH_CLIENT_ID=

# Optional: extra Web client IDs, comma-separated, if tokens may use another `aud`.
# GOOGLE_OAUTH_ADDITIONAL_CLIENT_IDS=

# Redirect URI string must match Google Cloud Console exactly (redirect-based OAuth).
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/your-google-callback-path

# Space-separated scopes for authorize URL (default is fine for email/profile).
GOOGLE_OAUTH_SCOPES=openid email profile

# -----------------------------------------------------------------------------
# Firebase Admin — verifies the Firebase ID tokens the web and mobile apps send to
# GraphQL `googleAuth` (Google sign-in). The backend then issues its own JWT pair;
# Firebase tokens are never used as API session tokens.
#
# Service account key: Firebase Console → Project settings → Service accounts →
# Generate new private key (project lipaidox-platform). The key must belong to
# FIREBASE_PROJECT_ID or it is ignored. SECRET — never commit it, never put it in
# the mobile app or any EXPO_PUBLIC_* / NEXT_PUBLIC_* variable.
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=lipaidox-platform

# Option A (Render / any host): two values copied out of the key JSON.
# FIREBASE_PRIVATE_KEY may keep the JSON's literal \n sequences and the quotes:
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Option B (local): path to the downloaded key file, kept outside git.
# Example: /home/you/secrets/lipaidox-platform-firebase-adminsdk.json
# FIREBASE_SERVICE_ACCOUNT_PATH=
# (FIREBASE_SERVICE_ACCOUNT_B64 / FIREBASE_SERVICE_ACCOUNT_JSON also work: base64 -w0 key.json)

# Refuse revoked tokens and disabled/deleted Firebase users (one Admin call per sign-in).
# FIREBASE_CHECK_REVOKED=True

# Local UI work only: with DEBUG=True also accept the literal token `test-google-token`.
# FIREBASE_ALLOW_TEST_TOKENS=False

# Cloud Run / GCE with workload identity may use ADC instead of a key:
# FIREBASE_ALLOW_APPLICATION_DEFAULT_CREDENTIALS=True

# -----------------------------------------------------------------------------
# Groq — vision LLM for the `/discover` page (lost_found.services.vision_service).
# Powers the Search, AI Verify, Price (image->product-name), and Community
# expert-verdict tabs via Llama 4 Scout (multimodal). Free tier: get a key in
# under a minute at https://console.groq.com/keys (no billing required;
# 1,000 requests/day, 30/minute — far more generous than Gemini's 20/day).
# Read directly via python-decouple in vision_service.py — does NOT go
# through settings.py.
# -----------------------------------------------------------------------------
GROK_API_KEY=
# Optional override of the model id (defaults to meta-llama/llama-4-scout-17b-16e-instruct if unset).
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── Payments (NBC / Haminass Pay) ────────────────────────────────────────────
# Without these two, the server runs payments in SIMULATION mode and the app
# refuses to take payment. On a host like Render, set them in the service's
# Environment settings (this file is only for local development).
# Verify afterwards:  manage.py check_payment_gateway   or   GET /payments/health/
PAYMENT_GATEWAY_DEFAULT=nbc
NBC_API_KEY=
NBC_API_BASE=https://accesspay.eopsprimax.com
# Wallet currency, and the currency NBC settles in (your key is provisioned for one).
NBC_CURRENCY=USD
NBC_SETTLEMENT_CURRENCY=TZS
NBC_USD_TO_TZS=2600
# Where NBC returns the browser after a card payment. The host must be approved on
# the key, or NBC returns 403 — leave empty until it is.
NBC_REDIRECT_URL=

# ── Media storage (Cloudinary) ─────────────────────────────────────────────
# Render's disk is wiped on every restart, so uploads must live off-box. With all
# three set, /api/upload/* streams files to Cloudinary and stores the https URL.
# Unset → falls back to local MEDIA_ROOT (fine for development, lossy on Render).
# Free plan limits: 10 MB per image, 100 MB per video.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lipaidox

# ── Redis, caching and Celery (all optional) ─────────────────────────────────
# PostgreSQL stays the source of truth; Redis only holds disposable data
# (cache entries with TTLs, the Celery queue). Leave these empty and the app
# behaves as before: in-process memory cache, background tasks run inline.
# See README.md → "Redis, caching and Celery".
#
# Local:       redis://127.0.0.1:6379/0
# Managed/TLS: rediss://:<password>@<host>:<port>/0   (never expose Redis publicly)
REDIS_URL=
# Use separate DB numbers (or instances) for cache, broker and results.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# Optional: namespace for cache keys (e.g. when staging and prod share a Redis).
# CACHE_KEY_PREFIX=lipaidox
# Optional: force inline task execution even with a broker set (debugging).
# CELERY_TASK_ALWAYS_EAGER=False
# Optional: recycle a worker process after N tasks / N KB of RAM.
# CELERY_WORKER_MAX_TASKS_PER_CHILD=200
# CELERY_WORKER_MAX_MEMORY_PER_CHILD=300000
